{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "Template from engineering-standards. .env.* is not denied by glob because permission rules cannot exempt .env.example; guard-files.py enforces the full rule.",
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run check:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(node --test:*)",
      "Bash(npx biome check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "ask": ["Bash(git push:*)", "Bash(gh pr merge:*)", "Bash(gh release:*)"],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(pkill -f:*)",
      "Bash(rm -rf /:*)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.local)",
      "Read(**/.env.local)",
      "Read(./.env.development)",
      "Read(**/.env.development)",
      "Read(./.env.production)",
      "Read(**/.env.production)",
      "Read(./.env.test)",
      "Read(**/.env.test)",
      "Read(./.env.staging)",
      "Read(**/.env.staging)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.py\""
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.py\""
          }
        ]
      }
    ]
  }
}
