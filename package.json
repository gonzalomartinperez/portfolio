{
  "name": "portfolio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Software engineering and applied AI portfolio built with Next.js, deployed on Hostinger.",
  "homepage": "https://gonzalomartinperez.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gonzalomartinperez/portfolio.git"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.6.0 <25",
    "npm": ">=11.5.1 <12"
  },
  "packageManager": "npm@11.5.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run test:architecture && npm run test:repository && npm run test:assistant-contract && npm run test:assistant && npm run typecheck:assistant && npm run test:content && npm run test:identity && npm run test:documents && npm run lint && npm run build && npm run test:budget",
    "test:repository": "node --test scripts/repository.test.mjs scripts/scene-budget.test.mjs scripts/cloud-layout.test.mjs scripts/browser-ci-planner.test.mjs scripts/architecture-diagrams.test.ts scripts/technology-models.test.ts",
    "test:content": "node --test scripts/content.test.mjs scripts/catalogue.test.mjs scripts/academic.test.mjs scripts/content-migration.test.mjs scripts/cv-export.test.mjs",
    "test:budget": "node --test scripts/budget.test.mjs",
    "test:rendered": "node --test scripts/rendered.test.mjs",
    "test:site": "node scripts/test-site.mjs",
    "test:documents": "node scripts/documents.ts",
    "cv:sync:check": "node scripts/export-cv.mjs --check",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:assistant-disabled": "playwright test --config playwright.rollout.config.ts",
    "test:browser": "playwright test",
    "test:identity": "node scripts/generate-identity.mjs --check",
    "identity:build": "node scripts/generate-identity.mjs --write",
    "test:assistant-contract": "node scripts/check-assistant-contract.mjs",
    "test:assistant": "node --test scripts/assistant-*.test.ts",
    "typecheck:assistant": "next typegen && tsc --project tsconfig.assistant.json --noEmit",
    "contract:generate": "npm ci --prefix tooling/api-contract --prefer-offline --no-audit --no-fund && npm run generate --prefix tooling/api-contract",
    "test:architecture": "node --test scripts/architecture.test.mjs && node scripts/architecture.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "2.5.15",
    "@next/swc-wasm-nodejs": "16.4.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  }
}
