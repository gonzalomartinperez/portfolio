{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal personal portfolio built with Next.js and TypeScript.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.6.0 <25",
    "npm": ">=11.5.1 <12"
  },
  "packageManager": "npm@11.5.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@next/swc-wasm-nodejs": "16.3.5",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
