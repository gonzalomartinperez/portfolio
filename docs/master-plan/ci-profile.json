{
  "$comment": "Draft for docs/master-plan/ci-profile.json, moved to .github/ci-profile.json at M1 (PF-M1-2). Validated by tests/unit/ci-profile.test.ts: every tracked path matches at least one group; unknown paths run everything (fail closed).",
  "version": 1,
  "repo": "portfolio",
  "ecosystem": "v1",
  "gate_job": "ci-gate",
  "fail_closed": true,
  "groups": {
    "docs": [
      "**/*.md",
      "docs/**",
      "LICENSE",
      "NOTICE.md",
      ".github/ISSUE_TEMPLATE/**",
      ".github/pull_request_template.md",
      ".github/CODEOWNERS",
      ".agents/skills/**",
      ".claude/skills/**",
      ".claude/agents/**",
      "public/.well-known/**"
    ],
    "code": [
      "src/**",
      "content/**",
      "config/**",
      "tests/**",
      "tools/**",
      "public/**",
      "media/**",
      "ratchets/**",
      "package.json",
      "package-lock.json",
      "tsconfig*.json",
      "biome.json",
      "components.json",
      "next.config.mjs",
      "postcss.config.mjs",
      "playwright*.ts",
      ".nvmrc",
      ".npmrc",
      ".env.example",
      ".editorconfig",
      ".gitattributes",
      ".gitignore",
      ".devcontainer/**",
      ".claude/settings.json",
      ".claude/hooks/**",
      ".codex/**",
      ".mcp.json",
      "release-please-config.json",
      ".release-please-manifest.json"
    ],
    "contract": ["contracts/**", "tools/api-contract/**", "tools/check-assistant-contract.ts"],
    "scene": [
      "src/features/hero/**",
      "src/features/solar-system/**",
      "src/shared/scene/**",
      "src/shared/motion/**",
      "src/shared/identity/monogram.ts",
      "public/images/solar-system/**",
      "config/solar-textures.ts",
      "tools/render-posters.ts",
      "tools/frame-budget.ts"
    ],
    "design": [
      "src/design/**",
      "src/app/globals.css",
      "src/app/fonts.ts",
      "src/shared/ui/**",
      "src/shared/editorial/**",
      "src/shell/**",
      "src/views/**",
      "**/*.module.css",
      "tools/build-tokens.ts",
      "tools/css-policy.ts"
    ],
    "content": [
      "content/**",
      "contracts/**/*.json",
      "public/*.pdf",
      "tools/export-cv.ts",
      "src/views/metadata.ts",
      "src/app/sitemap.ts",
      "src/app/robots.ts"
    ],
    "hosting": [
      "next.config.mjs",
      "package.json",
      "package-lock.json",
      ".nvmrc",
      "tools/ci-build-*.ts",
      "tools/smoke-test.ts",
      "tools/test-server.ts",
      "tools/test-site.ts"
    ],
    "dependencies": [
      "package.json",
      "package-lock.json",
      "tools/api-contract/package.json",
      "tools/api-contract/package-lock.json"
    ],
    "workflow": [".github/**"]
  },
  "profiles": {
    "docs": {
      "when": { "only_groups": ["docs"] },
      "run": [
        "markdownlint",
        "lychee",
        "vale-en",
        "skills-validate",
        "readme-headings",
        "secret-scan"
      ],
      "skip": ["build", "unit", "e2e", "visual", "lighthouse", "mutation", "hosting"],
      "budget_p50_minutes": 2
    },
    "deps-weekly": {
      "when": { "branch_prefix": "dependabot/" },
      "run": [
        "code",
        "dependency-review",
        "licence-check",
        "sbom-diff",
        "lockfile-lint",
        "hosting"
      ],
      "skip": [],
      "budget_p50_minutes": 8
    },
    "code": {
      "when": { "default": true },
      "run": [
        "static",
        "unit",
        "architecture-guard",
        "build-once",
        "bundle-budget",
        "e2e-chromium-iphone-webkit",
        "axe-affected",
        "mutation-incremental",
        "secret-scan",
        "security"
      ],
      "conditional": {
        "visual-affected": ["design", "scene"],
        "lighthouse-one-route": ["design", "scene"],
        "fluidity": ["scene"],
        "hero-snapshots": ["scene"],
        "contract-compile": ["contract"],
        "content-tests": ["content"],
        "hosting-rocky8": ["hosting"]
      },
      "skip": ["unaffected suites"],
      "budget_p50_minutes": 5,
      "budget_p95_minutes": 10
    },
    "contract": {
      "when": { "any_group": ["contract"] },
      "run": ["code", "contract-regenerate-no-diff", "consumer-compile", "event-schema-examples"],
      "requires_label_for_breaking": "contract-major",
      "budget_p50_minutes": 7
    },
    "workflow": {
      "when": { "any_group": ["workflow"] },
      "run": [
        "actionlint",
        "zizmor",
        "sha-pin-policy",
        "workflow-policy-fixtures",
        "dry-run-reusable-workflow"
      ],
      "budget_p50_minutes": 3
    },
    "release": {
      "when": { "base": "main", "head": "develop" },
      "run": [
        "full-matrix-all-engines",
        "mutation-full-or-last-nightly-24h",
        "lighthouse-all-routes",
        "visual-all-routes",
        "hero-snapshots",
        "fluidity",
        "hosting-rocky8",
        "changelog-check",
        "build-info-check"
      ],
      "skip": [],
      "budget_p50_minutes": 30
    },
    "hotfix": {
      "when": { "head_prefix": "hotfix/", "base": "main", "label": "owner-authorized" },
      "run": ["code", "release-verification-touched-surfaces", "auto-backmerge-pr"],
      "budget_p50_minutes": 10
    }
  },
  "nightly": [
    "mutation-full",
    "flake-detector",
    "full-browser-matrix",
    "visual-all",
    "hero-snapshots",
    "fluidity",
    "lighthouse-all-routes",
    "zap-baseline",
    "scorecard-json-ratchet",
    "osv-grype",
    "links",
    "scorecard-ossf"
  ],
  "weekly": [
    "deps-weekly-guard",
    "docs-link-check",
    "standards-drift",
    "ci-duration-report",
    "gpu-lane",
    "skills-staleness"
  ]
}
